# Absolute path to your project directory
PROJECT_ROOT=/path/to/your/project

# Port for the MCP server (default 3333)
PORT=3333

# Optional: static ngrok domain so your URL never changes between restarts.
# ngrok free tier gives one free static domain per account:
#   1. Go to https://dashboard.ngrok.com/domains
#   2. Claim your free domain (e.g. your-name.ngrok-free.app)
#   3. Paste it here (without https:// or /sse)
# Paid ngrok plans and self-hosted reverse proxies also work here.
# Leave blank to use a random URL (you'll need to recreate the ChatGPT connector each restart).
# NGROK_DOMAIN=your-name.ngrok-free.app
